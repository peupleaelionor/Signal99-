# ──────────────────────────────────────────────────────────────
# SIGNAL99 — environment variables
# Copy to `.env.local` and fill in. The app runs without any of these
# (premium fallback + mock/payment-link), but payment, AI personalization
# and persistence need the relevant keys.
# ──────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Used for share links, OG images, redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payment (revenue-first) ────────────────────────────────────
# How the "Unlock my card — $0.99" button takes money:
#   payment_link    → redirect to a Stripe/PayPal Payment Link (ships fastest)
#   stripe_checkout → full Stripe Checkout + webhook (server source of truth)
#   mock_dev        → dev-only simulated unlock
NEXT_PUBLIC_PAYMENT_MODE=payment_link

# The hosted Payment Link (Stripe Payment Link or PayPal). Used when
# NEXT_PUBLIC_PAYMENT_MODE=payment_link. Configure its success URL to /paid.
NEXT_PUBLIC_SIGNAL99_PAYMENT_LINK=

# Dev-only: show a "Simulate payment" button to unlock without a provider.
# NEVER true in production (force-disabled when NODE_ENV=production).
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT=true

# Public contact used as an ultimate "never lose a payer" fallback (mailto).
NEXT_PUBLIC_CONTACT_EMAIL=

# Post-purchase "Full Signal Guide" upsell. Keep false until the content ships.
NEXT_PUBLIC_ENABLE_UPSELL=false

# ── Stripe (for stripe_checkout mode) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional pre-created Price ID for the $0.99 unlock. If empty, an inline price
# is built automatically.
STRIPE_PRICE_SIGNAL99=

# ── Invisible AI (optional) ────────────────────────────────────
# AI is invisible and runs AFTER payment by default to control cost.
#   false → personalize on demand after payment (recommended)
#   true  → experimental: pre-generate after quiz completion
AI_PREGENERATE=false
# Provide ONE provider key to enable AI personalization. With none set, the
# premium deterministic fallback is used and the user never sees a difference.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model override (defaults: claude-haiku-4-5 / gpt-4o-mini).
AI_MODEL=

# ── Admin (orders export) ──────────────────────────────────────
# Guards GET /api/admin/orders. Unset → the endpoint is disabled.
ADMIN_SECRET=

# ── Supabase (optional) ────────────────────────────────────────
# When set, purchases + delivery orders persist to the documented tables.
# When empty, the app degrades gracefully (Stripe stays the source of truth,
# orders are kept in memory + server logs so a payer can still be recovered).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
