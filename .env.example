# ──────────────────────────────────────────────────────────────
# SIGNAL99 — environment variables
# Copy to `.env.local` and fill in. The app runs without any of these
# (mock mode), but payment + persistence need the relevant keys.
# ──────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Used for share links, OG images, Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only: show a "Simuler le paiement" button to unlock without Stripe.
# NEVER set to true in production (it is also force-disabled when NODE_ENV=production).
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT=true

# Post-purchase "Pack complet" upsell. Keep false until the pack content ships.
NEXT_PUBLIC_ENABLE_UPSELL=false

# ── Payment mode ───────────────────────────────────────────────
# stripe_checkout (default) — server-created Checkout session, binds one payment
#   to one quiz_result_id server-side (recommended).
# payment_link — redirect to a pre-made Stripe Payment Link (fastest to ship).
#   Pair with the /delivery fallback; needs the webhook + Supabase for durable
#   per-result unlock. Premium is still gated by server verification.
# mock_dev — dev simulation only.
NEXT_PUBLIC_PAYMENT_MODE=stripe_checkout
# Required only when NEXT_PUBLIC_PAYMENT_MODE=payment_link
NEXT_PUBLIC_SIGNAL99_PAYMENT_LINK=

# ── Storage driver (payment persistence) ───────────────────────
# auto (default): Supabase when configured, else stripe-only (no DB).
# Override with: supabase | stripe-only | kv
STORAGE_DRIVER=auto

# ── Stripe ─────────────────────────────────────────────────────
# Server secret key (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_... / pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: a pre-created Price ID for the 0,99 € unlock. If empty, an inline
# price is built automatically.
STRIPE_PRICE_SIGNAL99=

# ── Invisible AI personalization (optional) ────────────────────
# When unset, the curated premium templates are used (the product is unaffected
# and never branded as "AI"). When set, results are personalized then validated,
# with a guaranteed template fallback on any timeout/error.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_TIMEOUT_MS=9000
# Default false: AI runs after payment (cheaper, lower risk). Set true to
# pre-generate right after the quiz and test the instant "Signal ready" feel.
NEXT_PUBLIC_AI_PREGENERATE=false

# ── Email delivery (optional — Resend) ─────────────────────────
# When set, /api/delivery sends a real "Ta carte est prête" email.
RESEND_API_KEY=
RESEND_FROM=SIGNAL99 <onboarding@resend.dev>

# ── Distributed rate limiting (optional — Upstash Redis) ───────
# When set, rate limits are shared across instances; otherwise in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional, real sinks) ───────────────────────────
# Set either/both to wire a real provider; otherwise events log to dev console.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Supabase (optional) ────────────────────────────────────────
# When set, purchases + paid status are persisted to the documented tables.
# When empty, the app degrades gracefully (Stripe stays the source of truth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
